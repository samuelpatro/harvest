import { Theme } from "theme.slint";
import { Backend } from "globals.slint";
import { Card, PrimaryButton, GhostButton } from "components.slint";
import { LineEdit } from "std-widgets.slint";

// First-run overlay: choose + initialize the Harvest home directory.
export component SetupWizard inherits Rectangle {
    background: Theme.bg;

    Card {
        width: 560px;
        height: 340px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            padding: 28px;
            spacing: Theme.space-3;

            Text { text: "Welcome to Harvest"; color: Theme.text; font-size: 22px; font-weight: 700; }
            Text {
                text: "Choose where Harvest stores PHP, Node, services and site configs. "
                    + "This folder will be created and initialized.";
                color: Theme.text-muted;
                font-size: 13px;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 4px;
                Text { text: "Harvest home"; color: Theme.text; font-size: 13px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { text <=> Backend.wizard-path; }
                    GhostButton { text: "Browse…"; clicked => { Backend.wizard-browse(); } }
                }
            }

            if Backend.wizard-error != "" : Text {
                text: Backend.wizard-error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                PrimaryButton { text: "Get started"; clicked => { Backend.wizard-finish(); } }
            }
        }
    }
}

// Design tokens mirrored from the Vue app's src/styles/main.css so the native
// UI keeps visual parity during the migration.
export global Theme {
    // Backgrounds
    out property <color> bg: #0d0d0f;
    out property <color> bg-elevated: #18181b;
    out property <color> bg-card: #1c1c1f;
    // Lines & text
    out property <color> border: #27272a;
    out property <color> text: #fafafa;
    out property <color> text-muted: #a1a1aa;
    // Accent & status
    out property <color> accent: #f59e0b;
    out property <color> accent-hover: #d97706;
    out property <color> success: #22c55e;
    out property <color> danger: #ef4444;

    // Radii
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 14px;

    // 4px spacing grid
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;

    // Type
    out property <string> font-ui: "Outfit";
    out property <string> font-mono: "JetBrains Mono";
}
